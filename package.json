{
  "name": "credit-lens",
  "version": "0.1.0",
  "description": "Credit Lens · Tu crédito, claro. Demo de centro de crédito personal para Colombia con datos ficticios.",
  "private": true,
  "license": "MIT",
  "author": "Jhon Maquilon (JFredDev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JFredMC/credit-lens.git"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "ng build --base-href /credit-lens/ && node scripts/postbuild-pages.mjs",
    "serve:pages": "node scripts/serve-pages.mjs",
    "test": "ng test --watch=false",
    "lint": "ng lint",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p e2e/tsconfig.json",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "docx": "^9.11.0",
    "jspdf": "^4.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.5.0",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "angular-eslint": "22.5.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
